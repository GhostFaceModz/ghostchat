# GhostChat local / Render environment
# Copy to .env and fill in real values. Never commit .env or real secrets.

PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:3000
# Production (Render): PUBLIC_URL=https://ghostchat.pro
# Optional override for share-page / OG canonicals (defaults to PUBLIC_URL, then https://ghostchat.pro)
# SHARE_BASE_URL=https://ghostchat.pro


# Shared GhostGames/GhostFlix Supabase project (GhostChat uses ghostchat_* tables only)
SUPABASE_URL=https://rswtambjckwmlagydsvf.supabase.co
SUPABASE_SERVICE_KEY=

# Signs dashboard session tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Chat models ---
# Default provider is OpenRouter, default model is deepseek/deepseek-v4-flash (very cheap, not $0).
# $0 options are the OpenRouter `:free` models in the dashboard picker.
# Owners pick a model per site; if that provider's key is missing, the bot falls back to OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
AI_PROVIDER=openrouter
OPENAI_API_KEY=
GROK_API_KEY=
# XAI_API_KEY=          # alias for GROK_API_KEY
GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=    # alias for GEMINI_API_KEY

# --- Embeddings (global, not per-site — must stay 384 dimensions) ---
# Default is local, key-free: hash/feature-384 (fits Render free RAM; no API cost).
# OpenRouter does not offer embeddings. Optional alternatives (OpenAI / Gemini / Grok) must
# request 384-d so they stay compatible with the local index.
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# EMBEDDING_PROVIDER=openai
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_PROVIDER=grok

# --- Owner sign-in (Discord + Google OAuth). Password auth still works. ---
# Redirect URIs:
#   {PUBLIC_URL}/api/auth/discord/callback
#   {GOOGLE_REDIRECT_BASE}/api/auth/google/callback
#   (GOOGLE_REDIRECT_BASE defaults to https://ghostchat-nfoc.onrender.com)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Origin registered on the Google OAuth client for the callback (no trailing slash).
# Direct-mode Google sign-in always uses {GOOGLE_REDIRECT_BASE}/api/auth/google/callback,
# then hands the session back to PUBLIC_URL. Override for local dev, e.g. http://localhost:3000
# GOOGLE_REDIRECT_BASE=https://ghostchat-nfoc.onrender.com

# --- Whop billing ---
# Webhook URL to paste in Whop: {PUBLIC_URL}/api/webhooks/whop
# Subscribe to membership.went_valid and membership.went_invalid (and/or membership.activated / deactivated).
WHOP_WEBHOOK_SECRET=
WHOP_API_KEY=
WHOP_PLAN_PRO_ID=
WHOP_PLAN_BUSINESS_ID=
WHOP_CHECKOUT_PRO_URL=
WHOP_CHECKOUT_BUSINESS_URL=

# --- Training ---
# Notion internal integration token. Share each imported page with the integration.
NOTION_API_KEY=

# --- Feature flags ---
# VOICE_ENABLED=true
# CRAWL_MAX_PAGES=40
# CRAWL_MAX_DEPTH=3
# FREE_MONTHLY_MESSAGES=200

# Protects POST /api/cron/recrawl and /api/cron/live-idle. Leave unset to disable those endpoints.
# CRON_SECRET=
