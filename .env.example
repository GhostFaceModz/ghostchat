# GhostChat local / Render environment
# Copy to .env and fill in real values. Never commit .env or real secrets.

PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:3000

# Shared GhostGames/GhostFlix Supabase project (GhostChat uses ghostchat_* tables only)
SUPABASE_URL=https://rswtambjckwmlagydsvf.supabase.co
SUPABASE_SERVICE_KEY=

# Signs dashboard session tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Chat models ---
# Default provider is Grok (xAI). Only providers with a key set are enabled.
# Owners pick a model per site in the dashboard; if that key is missing, the bot falls back to Grok.
GROK_API_KEY=
# XAI_API_KEY=          # alias for GROK_API_KEY
# GROK_MODEL=grok-4.7   # default chat model
OPENAI_API_KEY=
OPENROUTER_API_KEY=     # Zane will add this later
GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=    # alias for GEMINI_API_KEY

# Optional legacy single-provider override (still works):
# AI_PROVIDER=grok
# AI_BASE_URL=https://api.x.ai/v1
# AI_API_KEY=
# AI_MODEL=grok-4.7

# --- Embeddings (global, not per-site — must stay 1536 dimensions) ---
# Defaults: Grok `v1` if GROK_API_KEY is set, otherwise OpenAI text-embedding-3-small, otherwise Gemini gemini-embedding-001.
# OpenRouter is chat-only unless you point this at another 1536-d provider.
# EMBEDDING_PROVIDER=grok
# EMBEDDING_MODEL=v1
# AI_EMBEDDING_MODEL=v1

# --- Owner sign-in (Discord + Google OAuth). Password auth still works. ---
# Redirect URIs:
#   {PUBLIC_URL}/api/auth/discord/callback
#   {PUBLIC_URL}/api/auth/google/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Whop billing ---
# Webhook URL to paste in Whop: {PUBLIC_URL}/api/webhooks/whop
# Subscribe to membership.went_valid and membership.went_invalid (and/or membership.activated / deactivated).
WHOP_WEBHOOK_SECRET=
WHOP_API_KEY=
WHOP_PLAN_PRO_ID=
WHOP_PLAN_BUSINESS_ID=
WHOP_CHECKOUT_PRO_URL=
WHOP_CHECKOUT_BUSINESS_URL=

# --- Training ---
# Notion internal integration token. Share each imported page with the integration.
NOTION_API_KEY=

# --- Feature flags ---
# VOICE_ENABLED=true
# CRAWL_MAX_PAGES=40
# CRAWL_MAX_DEPTH=3
# FREE_MONTHLY_MESSAGES=200
