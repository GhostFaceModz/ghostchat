# GhostChat local / Render environment
# Copy to .env and fill in real values. Never commit .env or real secrets.

PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:3000

# Shared GhostGames/GhostFlix Supabase project (GhostChat uses ghostchat_* tables only)
SUPABASE_URL=https://rswtambjckwmlagydsvf.supabase.co
SUPABASE_SERVICE_KEY=

# OpenAI-compatible API (OpenAI, Groq, OpenRouter, xAI, etc.)
# Default model is cheap and strong enough for support-style answers.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# Signs dashboard session tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional overrides
# CRAWL_MAX_PAGES=40
# CRAWL_MAX_DEPTH=3
# FREE_MONTHLY_MESSAGES=200
# DASHBOARD_ORIGIN=http://localhost:3000
