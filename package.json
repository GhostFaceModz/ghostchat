{
  "name": "ghostchat",
  "version": "1.0.0",
  "private": true,
  "description": "GhostChat \u2014 a premium embeddable AI chatbot that answers from your own site content.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "npm run build:widget && tsc",
    "prefetch:embeddings": "node scripts/prefetch-embeddings.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build:widget": "node scripts/build-widget.mjs"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.76.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.7.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/qrcode": "^1.5.5",
    "cheerio": "^1.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "esbuild": "^0.25.12"
  },
  "devDependencies": {
    "tsx": "^4.20.6"
  }
}
